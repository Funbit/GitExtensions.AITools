<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GitExtensionsPath Condition="'$(GitExtensionsPath)' == ''">$(MSBuildThisFileDirectory)..\..\gitextensions.shared\v7.2.1</GitExtensionsPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GitExtensions.AITools\GitExtensions.AITools.csproj" />
    <Reference Include="GitExtensions.Extensibility" HintPath="$(GitExtensionsPath)\GitExtensions.Extensibility.dll" />
    <Reference Include="ResourceManager" HintPath="$(GitExtensionsPath)\ResourceManager.dll" />
  </ItemGroup>
</Project>
